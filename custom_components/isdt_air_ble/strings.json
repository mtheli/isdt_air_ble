{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Set up ISDT Device",
        "description": "Confirm the detected ISDT device to add it to Home Assistant."
      },
      "bluetooth_confirm": {
        "title": "Confirm detected device",
        "description": "Do you want to add **{name}** to Home Assistant?\n\nClick Submit to start pairing."
      },
      "pair": {
        "title": "Pair with {model}",
        "description": "Click Submit, then **press any button on the device** to confirm pairing.\n\nSome devices (like the MASS2) will beep; others just wait silently. You have 30 seconds to press a button after clicking Submit."
      },
      "show_device_info": {
        "title": "Device Info",
        "description": "Successfully connected to **{name}**.\n\n**Hardware Version:** {hw_version}\n**Firmware Version:** {fw_version}\n**Serial Number:** {serial_number}\n\n**GATT Characteristics:**\n{characteristics}\n\nClick Submit to finish setup."
      }
    },
    "error": {
      "cannot_connect": "Failed to connect to the device. Ensure it is powered on and in range.",
      "pairing_failed": "Pairing timed out. Please try again and press any button on the device within 30 seconds."
    },
    "abort": {
